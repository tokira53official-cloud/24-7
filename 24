import os
import sys
import time
import subprocess

APP_DIR = "/root/12022250"
BOT_FILE = "bot.py"
RESTART_DELAY = 5

def log(msg):
    print(f"[RUNNER] {msg}", flush=True)

def main():
    log("================================")
    log(" PrimeCloud Bot Auto Runner")
    log("================================")

    os.makedirs(APP_DIR, exist_ok=True)

    while True:
        try:
            bot_path = os.path.join(APP_DIR, BOT_FILE)

            if not os.path.isfile(bot_path):
                log(f"ERROR: {bot_path} not found")
                log("Retrying in 10 seconds...")
                time.sleep(10)
                continue

            log(f"Starting: cd {APP_DIR}")
            log("Starting: python3 bot.py")

            process = subprocess.Popen(
                [sys.executable, "-u", BOT_FILE],
                cwd=APP_DIR,
                stdin=subprocess.DEVNULL
            )

            exit_code = process.wait()

            log(f"bot.py stopped | Exit code: {exit_code}")
            log(f"Restarting in {RESTART_DELAY} seconds...")
            time.sleep(RESTART_DELAY)

        except KeyboardInterrupt:
            log("Runner stopped manually.")
            break

        except Exception as e:
            log(f"Runner error: {e}")
            time.sleep(10)

if __name__ == "__main__":
    main()
